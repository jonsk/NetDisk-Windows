<Project Sdk="WixToolset.Sdk/6.0.2">

  <!--
    NetDisk.Setup —— WiX MSI(R-25:工具版本、扩展、SDK **三处都钉 6.0.2**;
    禁止 `dotnet tool update` 全局升级 wix)。

    DE-D-20 起本工程做三件事:
      ①**先发布、再打包**(顺序不可颠倒):MSI 载荷是 `publish\**`,`dotnet build`
        会自动先跑一次自包含发布。踩过的同类坑:先 go build 再拷前端 → "编出来的
        是上一版,而日志一路绿灯";打包陈旧产物是同一个错误的另一种形态。
      ②**抑制三条 per-machine 前提的 ICE**(ICE38/ICE64/ICE91),而抑制被 R-26 的
        机械检查盯着(见 Product.wxs 顶部说明)。
      ③**签名钩子**:配了证书指纹($(SignCertThumbprint))就签名;没配则**显式打印
        "产物未签名"** —— 不静默跳过。没有证书时 SmartScreen 会告警,而验收里
        "有证书时告警消失"那一半的前提必须让日志说清楚,免得有人以为签过了。
  -->
  <PropertyGroup>
    <OutputName>NetDisk</OutputName>
    <OutputType>Package</OutputType>
    <!--
      版本:MSI 与 **exe 的文件版本**都由这一个入口驱动(`ProductVersion`)。
      为什么必须让每次构建的版本都不同(2026-09-13 实测缺陷):
        Windows Installer 拷文件时按"文件版本更新"规则决定要不要覆盖 ——
        旧包与新包的 exe 都是 1.0.0.0 时,日志里会出现
        `File: ...NetDisk.App.exe; Won't Overwrite; Existing file is of an equal or newer version`,
        **装完还是旧程序**,而安装"成功"、没有报错。真机复现过。
      默认值 1.0.0 只用于临时手编;正式出包由 `desktop/scripts/verify-msi.ps1` 传入
      `-p:ProductVersion=1.0.<git 提交数>`(单调递增、可复现),脚本随后会**断言装上去的 exe 版本号一致**。
    -->
    <!-- 默认版本也要**每次都不同**(见上面的说明):yyMM + ddHH,两部分都 ≤ 65535
         (FileVersion 的每一段是 UInt16,写成 yyMMdd 会溢出)。同一小时内两次手编会同版本,
         正式出包由脚本传 git 提交数,不受此限。 -->
    <NetDiskStampMonth>$([System.DateTime]::UtcNow.ToString("yyMM"))</NetDiskStampMonth>
    <NetDiskStampDayHour>$([System.DateTime]::UtcNow.ToString("ddHH"))</NetDiskStampDayHour>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.$(NetDiskStampMonth).$(NetDiskStampDayHour)</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>

    <!-- perUser-only 包(R-26)按官方建议抑制这几条 ICE -->
    <!--
      ICE60:自包含产物里有些 DLL/EXE 带版本资源但没有 Language 列。该列只在**多语言**
      安装里参与"按语言选文件",本项目是单语言包(而且 `Files` 集合并不支持逐文件给
      Language),所以按官方建议抑制 —— 与 ICE38/64/91 一样,抑制理由写在 Product.wxs 里。
      ICE61:开着 `AllowSameVersionUpgrades="yes"`(见 Product.wxs)时,生成的 Upgrade 表
      上界就等于当前版本,ICE61 必然报"The Maximum version is not less than the current product"。
      那正是我们要的行为(开发期同版本不同 ProductCode 必须能互相替换),所以按官方建议抑制。
    -->
    <SuppressIces>ICE38;ICE60;ICE61;ICE64;ICE91</SuppressIces>

    <!-- 打包前自动发布(设 false 可跳过,仅用于快速迭代;产物缺失时打包会直接失败) -->
    <PublishBeforePackaging Condition="'$(PublishBeforePackaging)' == ''">true</PublishBeforePackaging>

    <!-- 代码签名:证书指纹来自环境变量(证书不进仓库) -->
    <SignCertThumbprint Condition="'$(SignCertThumbprint)' == ''">$(NETDISK_SIGN_CERT_THUMBPRINT)</SignCertThumbprint>
    <SignTimestampUrl Condition="'$(SignTimestampUrl)' == ''">http://timestamp.digicert.com</SignTimestampUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <!-- 1 先发布、再打包 -->
  <Target Name="PublishAppBeforePackaging" BeforeTargets="BeforeBuild"
          Condition="'$(PublishBeforePackaging)' == 'true'">
    <!-- **先清空载荷目录**:`dotnet publish` 只覆盖它产出的文件,不会清理上一次的残留 ——
         而 MSI 收的是 `publish\**`,于是任何残留在里面的东西都会**被打进安装包**。
         这不是理论风险:实测从 publish 目录跑过一次 exe,它就地生成了 client.json/logs/state.db,
         下一次打包就把这些**用户数据**打进了 MSI(被下面的单文件自检抓住)。
         以前(几百个文件时)这种问题不会报错,只会让安装包里多带几个莫名其妙的文件。 -->
    <RemoveDir Directories="$(MSBuildThisFileDirectory)publish" />
    <!-- 单文件发布(2026-09-13 产品要求):载荷应当是**恰好一个** NetDisk.App.exe。
         属性在 App.csproj 里已默认为单文件,这里再显式传一遍 —— 打包链上"依赖别处默认值"
         最容易在别人改了工程属性后静默变回一堆散文件(而 MSI 照样能装上,只是不再单文件)。 -->
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\NetDisk.App\NetDisk.App.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:Version=$(ProductVersion) -o &quot;$(MSBuildThisFileDirectory)publish&quot; --nologo"
          StandardOutputImportance="low" />
  </Target>

  <!-- 载荷自检:发布产物必须在,且必须含主程序(否则会打出一个空壳 MSI 而日志全绿) -->
  <Target Name="VerifyPayload" BeforeTargets="BeforeBuild" DependsOnTargets="PublishAppBeforePackaging">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)publish\NetDisk.App.exe')"
           Text="打包前找不到 publish\NetDisk.App.exe —— 发布产物缺失(或发布失败)。拒绝打一个空壳 MSI。" />
    <!-- 单文件自检:载荷里**只允许**有主程序。多出 .dll/.pdb 说明单文件属性没生效 ——
         那种 MSI 装上去照样能跑,所以不加这条断言的话没人会发现"又变回一堆文件了"。 -->
    <ItemGroup>
      <UnexpectedPayload Include="$(MSBuildThisFileDirectory)publish\**\*.*"
                         Exclude="$(MSBuildThisFileDirectory)publish\NetDisk.App.exe" />
    </ItemGroup>
    <Error Condition="'@(UnexpectedPayload)' != ''"
           Text="单文件发布自检失败:载荷里除了 NetDisk.App.exe 还有 @(UnexpectedPayload->'%(Filename)%(Extension)', ', ')。请检查 PublishSingleFile / AllowedReferenceRelatedFileExtensions 是否被改掉。" />
  </Target>

  <!--
    3 签名钩子(有证书才签;没证书**显式告警**,不静默跳过)。
    signtool 来自 Windows SDK;SHA256 + 时间戳(没有时间戳的签名在证书过期后失效)。
  -->
  <Target Name="SignMsi" AfterTargets="Build" Condition="'$(SignCertThumbprint)' != ''">
    <Exec Command="signtool sign /sha1 &quot;$(SignCertThumbprint)&quot; /fd SHA256 /tr &quot;$(SignTimestampUrl)&quot; /td SHA256 &quot;$(TargetPath)&quot;"
          ContinueOnError="false" />
    <Message Importance="high" Text="已签名:$(TargetPath)(证书指纹 $(SignCertThumbprint))" />
  </Target>

  <Target Name="WarnUnsigned" AfterTargets="Build" Condition="'$(SignCertThumbprint)' == ''">
    <Message Importance="high"
             Text="MSI 未签名:未配置证书指纹(NETDISK_SIGN_CERT_THUMBPRINT)。未签名安装包会触发 SmartScreen 告警 —— 发布前请配置证书(见 Doc/WiX-配置指南.md)。" />
  </Target>

</Project>
