<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NetDisk.App —— WPF UI(唯一允许 UseWPF 的工程;Setup 是打包工程,不算)。

    `net10.0-windows` + `UseWPF=true`(E-05 已实测:`dotnet build -c Release`
    0 警告 0 错误)。MVVM;所有平台无关逻辑都在 ClientCore/SyncEngine/Transport,
    本工程只做"把状态画出来 + 把用户动作转成用例调用"。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘气泡(NotifyIcon)来自 Windows Forms;depsguard 规则②:只有 App 可开 UI 框架 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 关掉 WinForms 的**隐式 using**:否则它与 WPF 的隐式 using 撞在一起,
         `Application`/`UserControl` 等类型全部变成"不明确的引用"(编译器只报歧义,
         不告诉你是哪来的)。托盘那个文件自己显式 `using System.Windows.Forms;` 即可。 -->
    <DisableImplicitNamespaceImports_WindowsForms>true</DisableImplicitNamespaceImports_WindowsForms>
    <RootNamespace>NetDisk.App</RootNamespace>
    <AssemblyName>NetDisk.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      ===== 打包方式:单文件发布(产品要求,2026-09-13)=====
      目标:`dotnet publish` 后**只有一个 exe**,双击即用(自包含,目标机无需预装 .NET)。

      三个属性各解决一件事:
        · `RuntimeIdentifier=win-x64` + `SelfContained=true`:自包含单文件**必须**指定 RID
          (单文件是把运行时一起打包,没有 RID 就不知道打哪一份)。
        · `PublishSingleFile=true`:把托管程序集合成一个 exe。
        · `IncludeNativeLibrariesForSelfExtract=true`:SQLite 的原生库(e_sqlite3.dll)
          必须**塞进** exe,否则运行时会去 exe 旁边找它 —— 而"旁边什么都没有"正是单文件的目标。
          代价是首次运行会释放到临时目录(运行时自己管理,卸载时随之清理)。
        · `EnableCompressionInSingleFile=true`:压缩内嵌内容(exe 从 ~150MB 降到 ~65MB)。
          代价是启动时解压一次;实测启动到写日志 <1s,用户无感,换取 MSI 体积减半是划算的。
        · `DebugType=embedded`:把符号塞进 exe,不额外产出 .pdb ——
          否则发布目录会多一个文件,"单文件"名不副实(且 pdb 对最终用户无用)。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- 只留 exe:**引用工程**仍会各自产出 .pdb,默认会被拷到发布目录里 ——
         结果是"单文件"旁边躺着 3 个 pdb(实测)。这个属性把"引用工程的附属文件"一律挡掉,
         与 DebugType=embedded 配合才能做到发布目录里**恰好一个文件**。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetDisk.ClientCore\NetDisk.ClientCore.csproj" />
    <ProjectReference Include="..\NetDisk.Transport\NetDisk.Transport.csproj" />
    <ProjectReference Include="..\NetDisk.SyncEngine\NetDisk.SyncEngine.csproj" />
  </ItemGroup>

  <!--
    版本号自动推导(2026-09-17):dotnet publish 不传 Version 属性时,自动取
    git 提交计数得到 1.0.&lt;提交数&gt;(单调递增、可复现,与 scripts/verify-publish.ps1 同源)。
    只在调用方没显式给版本时生效(命令行 -p:Version=... 优先级更高)。

    为什么必须在这里同时写 Version/AssemblyVersion/FileVersion/InformationalVersion:
      Directory.Build.props 在**求值阶段**把 Version 定为默认 1.0.0,SDK 也据此在求值期
      派生出程序集版本属性;而 GenerateAssemblyInfo 真正写 AssemblyInfo.cs 是在**执行阶段**
      (读取当时的属性值)。所以只改 Version 是不够的 —— 必须把四个版本属性一起在执行期
      覆盖,GenerateAssemblyInfo 才会写进 1.0.&lt;提交数&gt;。

    判定"调用方是否显式给版本":用 Directory.Build.props 的默认 1.0.0 作哨兵 ——
      若当前 Version 仍是这个默认值,说明没被命令行覆盖,才做自动推导;
      否则原样保留调用方传入的版本。
    无 git(纯拷贝构建)时保持 1.0.0。
  -->
  <Target Name="ComputeNetDiskBuildVersion"
          BeforeTargets="PrepareForBuild;GenerateAssemblyInfo;GetAssemblyVersion">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NetDiskGitCount" />
      <Output TaskParameter="ExitCode" PropertyName="_NetDiskGitExit" />
    </Exec>
    <PropertyGroup>
      <!-- 哨兵判断:仅当仍停在默认 1.0.0(未被命令行覆盖)且 git 可取时,才自动推导 -->
      <Version Condition="'$(Version)' == '1.0.0' and '$(_NetDiskGitExit)' == '0' and '$(_NetDiskGitCount)' != ''">1.0.$(_NetDiskGitCount.Trim())</Version>
      <!-- 程序集版本属性必须在执行期一起覆盖(见上方注释);
           InformationalVersion 的 +server.1.0.0 后缀是**服务端版本**锚点(ADR-3),
           固定不变,只有基础版本跟随桌面端推导。 -->
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)+server.1.0.0</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
