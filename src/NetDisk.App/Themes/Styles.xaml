<!--
  NetDisk 浅色设计系统（纯 XAML，零新增 NuGet 依赖）。
  用法：App.xaml 通过 MergedDictionaries 引入本文件即可，所有控件自动套用统一样式。
  图标统一用 Segoe MDL2 Assets 字形（TextBlock + FontFamily="Segoe MDL2 Assets"），
  不引入任何图片资源，守住“发布目录恰好一个 exe”铁律。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 调色板（浅色） ============ -->
  <Color x:Key="C.AppBg">#F4F6F9</Color>
  <Color x:Key="C.Surface">#FFFFFF</Color>
  <Color x:Key="C.SurfaceAlt">#F8FAFC</Color>
  <Color x:Key="C.Sidebar">#0F1B2D</Color>
  <Color x:Key="C.SidebarItem">#16263B</Color>
  <Color x:Key="C.SidebarActive">#1E3A5F</Color>

  <Color x:Key="C.Border">#E3E8EF</Color>
  <Color x:Key="C.BorderStrong">#CBD2DC</Color>

  <Color x:Key="C.TextPrimary">#1F2733</Color>
  <Color x:Key="C.TextSecondary">#5B6573</Color>
  <Color x:Key="C.TextMuted">#8A94A6</Color>
  <Color x:Key="C.TextOnDark">#E6ECF5</Color>
  <Color x:Key="C.TextOnDarkMuted">#9FB0C7</Color>

  <Color x:Key="C.Accent">#2B6CEF</Color>
  <Color x:Key="C.AccentHover">#1F5BD6</Color>
  <Color x:Key="C.AccentPressed">#1750C0</Color>
  <Color x:Key="C.AccentSoft">#E7F0FF</Color>

  <Color x:Key="C.Danger">#D64550</Color>
  <Color x:Key="C.DangerSoft">#FDECEC</Color>
  <Color x:Key="C.Warning">#C77700</Color>
  <Color x:Key="C.Success">#1F9D55</Color>

  <SolidColorBrush x:Key="AppBg" Color="{StaticResource C.AppBg}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
  <SolidColorBrush x:Key="SidebarBg" Color="{StaticResource C.Sidebar}" />
  <SolidColorBrush x:Key="SidebarItem" Color="{StaticResource C.SidebarItem}" />
  <SolidColorBrush x:Key="SidebarActive" Color="{StaticResource C.SidebarActive}" />

  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource C.Border}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource C.BorderStrong}" />

  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource C.TextPrimary}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource C.TextSecondary}" />
  <SolidColorBrush x:Key="TextMuted" Color="{StaticResource C.TextMuted}" />
  <SolidColorBrush x:Key="TextOnDark" Color="{StaticResource C.TextOnDark}" />
  <SolidColorBrush x:Key="TextOnDarkMuted" Color="{StaticResource C.TextOnDarkMuted}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource C.Accent}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource C.AccentHover}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource C.AccentPressed}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource C.AccentSoft}" />

  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource C.Danger}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource C.DangerSoft}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource C.Warning}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource C.Success}" />

  <!-- ============ 基础字体 / 排版 ============ -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource AppBg}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style TargetType="UserControl">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <!-- 图标字形：Segoe MDL2 Assets -->
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============ 卡片 ============ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.07" Color="#1F2733" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 卡片标题 -->
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <!-- 分区副标题（卡片内小标题） -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- ============ 按钮 ============ -->
  <!-- 默认（次要 / 描边） -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAlt}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#EEF1F6" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="#F2F4F7" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="#E6E9EF" />
              <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主按钮（强调色实心） -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="#B9C6E0" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="#B9C6E0" />
              <Setter Property="Foreground" Value="#EAF0FA" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 危险按钮（红） -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="#F0C2C5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FBDADA" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 文字链接按钮 -->
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
              <Setter Property="TextBlock.TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 输入框 ============ -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="#F4F6F9" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,4,0,4" />
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,3,0,3" />
  </Style>

  <!-- ============ 进度条 ============ -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="#E9EDF3" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============ 列表 ============ -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
  </Style>

  <!-- ListView 行：悬停高亮 -->
  <Style TargetType="ListViewItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="#F0F2F6" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- GridView 列头 -->
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- ============ 分隔线 ============ -->
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="Margin" Value="0,10,0,10" />
  </Style>

  <!-- ============ 滚动条（细一点，更精致） ============ -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
  </Style>

  <!-- ============ 侧边栏导航 ============ -->
  <Style x:Key="SidebarNav" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextOnDarkMuted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
            <Grid Margin="10,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Name="Glyph" FontFamily="Segoe MDL2 Assets"
                         Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                         FontSize="16" Foreground="{StaticResource TextOnDarkMuted}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="1" x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{StaticResource TextOnDarkMuted}" FontSize="13"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarItem}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextOnDark}" />
              <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextOnDark}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActive}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="White" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
