<Window x:Class="NetDisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetDisk.App.Views"
        Title="NetDisk" Height="620" Width="900"
        WindowStartupLocation="CenterScreen">
  <!-- 主窗口只做"承载":团队空间协作视图(DE-D-17)先接进来;登录/同步/托盘在 DE-D-15~18 接入。 -->
  <TabControl Margin="8">
    <TabItem Header="团队空间">
      <views:SpacesView />
    </TabItem>
    <TabItem Header="关于">
      <StackPanel Margin="16">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="NetDisk 桌面端" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="同步引擎、传输队列、托盘与通知在后续任务中接入(DE-D-18~21)。" />
        <TextBlock Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                   Text="平台无关逻辑在 NetDisk.ClientCore / SyncEngine / Transport;本窗口只做渲染与动作转发。" />
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>