<Window x:Class="NetDisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetDisk.App.Views"
        xmlns:loc="clr-namespace:NetDisk.App.Localization"
        Title="{Binding [App.WindowTitle], Source={x:Static loc:Loc.Instance}}" Height="680" Width="980"
        WindowStartupLocation="CenterScreen">
  <!-- 主窗口只做"承载":登录页 → (登录成功后)同步/远端/空间/分享/设置/关于。
       导航从经典 TabControl 改为左侧 Sidebar(图标+文字),更接近 Dropbox/OneDrive 的形态。 -->
  <Grid>
    <!-- 登录覆盖层:未登录时占满主区 -->
    <views:LoginView x:Name="Login" Visibility="Collapsed" SignedIn="OnSignedIn" />

    <!-- 已登录主壳:左导航 + 右内容 -->
    <Grid x:Name="Shell" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="212" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 侧边栏 -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
              BorderBrush="#1B2C42" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <!-- 品牌 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,12,16">
            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" FontSize="17"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding [App.WindowTitle], Source={x:Static loc:Loc.Instance}}"
                       Foreground="{StaticResource TextOnDark}" FontSize="15" FontWeight="SemiBold"
                       Margin="11,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <!-- 导航项(顺序即内容区顺序) -->
          <ListBox x:Name="NavList" DockPanel.Dock="Top" Style="{StaticResource SidebarNav}"
                   ItemContainerStyle="{StaticResource SidebarItemStyle}"
                   SelectionChanged="OnNavSelectionChanged" SelectedIndex="0">
            <ListBoxItem Tag="&#xE895;" Content="{Binding [Main.Sync], Source={x:Static loc:Loc.Instance}}" />
            <ListBoxItem Tag="&#xE753;" Content="{Binding [Main.Remote], Source={x:Static loc:Loc.Instance}}" />
            <ListBoxItem Tag="&#xE7EE;" Content="{Binding [Main.Spaces], Source={x:Static loc:Loc.Instance}}" />
            <ListBoxItem Tag="&#xE9F7;" Content="{Binding [Main.MyShares], Source={x:Static loc:Loc.Instance}}" />
            <ListBoxItem Tag="&#xE713;" Content="{Binding [Main.Settings], Source={x:Static loc:Loc.Instance}}" />
            <ListBoxItem Tag="&#xE946;" Content="{Binding [App.AboutTab], Source={x:Static loc:Loc.Instance}}" />
          </ListBox>

          <!-- 侧边栏底部：版本小字 -->
          <TextBlock DockPanel.Dock="Bottom" Margin="18,10"
                     Foreground="{StaticResource TextOnDarkMuted}" FontSize="11">
            <Run Text="NetDisk · " /><Run x:Name="SidebarVersion" />
          </TextBlock>
        </DockPanel>
      </Border>

      <!-- 内容区：六个视图叠放,按 NavList.SelectedIndex 切换 Visibility -->
      <Grid Grid.Column="1" Margin="0">
        <views:SyncView x:Name="Sync" Visibility="Collapsed" />
        <views:RemoteView x:Name="Remote" Visibility="Collapsed" />
        <views:SpacesView x:Name="Spaces" Visibility="Collapsed" />
        <views:MySharesView x:Name="MyShares" Visibility="Collapsed" />
        <views:SettingsView x:Name="Settings" Visibility="Collapsed"
                            RestartRequested="OnRestartRequested" LogoutRequested="OnLogoutRequested" />

        <!-- 关于 -->
        <ScrollViewer x:Name="About" Visibility="Collapsed" Padding="24" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="{Binding [App.WindowTitle], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock x:Name="VersionText" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="{Binding [App.AboutDesc], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Text="{Binding [App.AboutPlatform], Source={x:Static loc:Loc.Instance}}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [App.CheckUpdate], Source={x:Static loc:Loc.Instance}}" />
                <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="{Binding [App.CheckUpdateDesc], Source={x:Static loc:Loc.Instance}}" />
                <Button x:Name="CheckUpdateButton" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Padding="16,8"
                        Content="{Binding [App.CheckUpdate], Source={x:Static loc:Loc.Instance}}" Click="OnCheckUpdate" />
                <TextBlock x:Name="UpdateStatusText" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
