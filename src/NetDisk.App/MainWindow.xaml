<Window x:Class="NetDisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetDisk.App.Views"
        xmlns:loc="clr-namespace:NetDisk.App.Localization"
        Title="{Binding [App.WindowTitle], Source={x:Static loc:Loc.Instance}}" Height="680" Width="980"
        WindowStartupLocation="CenterScreen">
  <!-- 主窗口只做"承载":登录页 → (登录成功后)同步/团队空间/关于。
       为什么要先登录:装完客户端直接进同步页的话,用户面对的是一个永远空白的列表
       (没有令牌 → 请求全是匿名的),而界面上没有任何地方能填服务器地址与账号。 -->
  <Grid>
    <views:LoginView x:Name="Login" Visibility="Collapsed" SignedIn="OnSignedIn" />

    <TabControl x:Name="Tabs" Margin="8" Visibility="Collapsed">
      <TabItem Header="{Binding [Main.Sync], Source={x:Static loc:Loc.Instance}}">
        <views:SyncView x:Name="Sync" />
      </TabItem>
      <TabItem Header="{Binding [Main.Remote], Source={x:Static loc:Loc.Instance}}">
        <views:RemoteView x:Name="Remote" />
      </TabItem>
      <TabItem Header="{Binding [Main.Spaces], Source={x:Static loc:Loc.Instance}}">
        <views:SpacesView x:Name="Spaces" />
      </TabItem>
      <TabItem Header="{Binding [Main.MyShares], Source={x:Static loc:Loc.Instance}}">
        <views:MySharesView x:Name="MyShares" />
      </TabItem>
      <TabItem Header="{Binding [Main.Settings], Source={x:Static loc:Loc.Instance}}">
        <views:SettingsView x:Name="Settings" RestartRequested="OnRestartRequested" LogoutRequested="OnLogoutRequested" />
      </TabItem>
      <TabItem Header="{Binding [App.AboutTab], Source={x:Static loc:Loc.Instance}}">
        <StackPanel Margin="16">
          <TextBlock FontSize="18" FontWeight="SemiBold"
                     Text="{Binding [App.WindowTitle], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock x:Name="VersionText" Margin="0,8,0,0" Foreground="#666" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="{Binding [App.AboutDesc], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                     Text="{Binding [App.AboutPlatform], Source={x:Static loc:Loc.Instance}}" />

          <!-- 自动更新入口:选一个**新版本安装包**,按"暂停同步 → 排空 → 迁移 → 启动更新器"升级。
               为什么让用户选包而不是自动下载:契约里没有"更新清单/下载"端点(只有 /version),
               假装能自动下载等于给一个永远失败的按钮。 -->
          <Button x:Name="CheckUpdateButton" Margin="0,16,0,0" Padding="16,6" HorizontalAlignment="Left"
                  Content="{Binding [App.CheckUpdate], Source={x:Static loc:Loc.Instance}}" Click="OnCheckUpdate" />
          <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap" />
          <TextBlock Margin="0,6,0,0" Foreground="#888" TextWrapping="Wrap"
                     Text="{Binding [App.CheckUpdateDesc], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
