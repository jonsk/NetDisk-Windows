<Window x:Class="NetDisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetDisk.App.Views"
        Title="NetDisk" Height="680" Width="980"
        WindowStartupLocation="CenterScreen">
  <!-- 主窗口只做"承载":登录页 → (登录成功后)同步/团队空间/关于。
       为什么要先登录:装完客户端直接进同步页的话,用户面对的是一个永远空白的列表
       (没有令牌 → 请求全是匿名的),而界面上没有任何地方能填服务器地址与账号。 -->
  <Grid>
    <views:LoginView x:Name="Login" Visibility="Collapsed" SignedIn="OnSignedIn" />

    <TabControl x:Name="Tabs" Margin="8" Visibility="Collapsed">
      <TabItem Header="同步">
        <views:SyncView x:Name="Sync" />
      </TabItem>
      <TabItem Header="团队空间">
        <views:SpacesView x:Name="Spaces" />
      </TabItem>
      <TabItem Header="设置">
        <views:SettingsView x:Name="Settings" RestartRequested="OnRestartRequested" LogoutRequested="OnLogoutRequested" />
      </TabItem>
      <TabItem Header="关于">
        <StackPanel Margin="16">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="NetDisk 桌面端" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="本机与服务器双向同步:本地改动自动上传,服务器改动自动下载,两端同时改动时保留冲突副本。" />
          <TextBlock Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                     Text="平台无关逻辑在 NetDisk.ClientCore / SyncEngine / Transport;本窗口只做渲染与动作转发。" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
