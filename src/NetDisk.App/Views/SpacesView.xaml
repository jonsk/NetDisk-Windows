<UserControl x:Class="NetDisk.App.Views.SpacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 团队空间协作 + 分享创建(DE-D-17)。按钮不做事前权限门禁,被拒时显示服务端原因。 -->
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左:空间列表 + 建空间 + 分享 -->
    <StackPanel Grid.Column="0" Margin="0,0,14,0">
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}"
                     Text="{Binding [Spaces.Title], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Margin="0,0,0,10" Foreground="{StaticResource TextSecondary}"
                     Text="{Binding [Spaces.Subtitle], Source={x:Static loc:Loc.Instance}}" />
          <ListBox x:Name="SpaceList" Height="180" SelectionChanged="OnSpaceSelected" />

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="NewSpaceName" Width="160" />
            <Button x:Name="CreateSpaceButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Padding="14,8"
                    Content="{Binding [Spaces.Create], Source={x:Static loc:Loc.Instance}}" Click="OnCreateSpace" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}"
                     Text="{Binding [Spaces.CreateShareTitle], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}"
                     Text="{Binding [Spaces.ShareFileId], Source={x:Static loc:Loc.Instance}}" />
          <TextBox x:Name="ShareFileId" Margin="0,0,0,8" />

          <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Spaces.ShareExpires], Source={x:Static loc:Loc.Instance}}" />
          <TextBox x:Name="ShareExpiresHours" Margin="0,0,0,8" Text="24" />

          <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Spaces.ShareMaxDownloads], Source={x:Static loc:Loc.Instance}}" />
          <TextBox x:Name="ShareMaxDownloads" Margin="0,0,0,8" />

          <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Spaces.SharePassword], Source={x:Static loc:Loc.Instance}}" />
          <TextBox x:Name="SharePassword" Margin="0,0,0,10" />

          <Button x:Name="CreateShareButton" Style="{StaticResource PrimaryButton}" Padding="14,8"
                  Content="{Binding [Spaces.CreateShare], Source={x:Static loc:Loc.Instance}}" Click="OnCreateShare" />
          <TextBox x:Name="ShareLink" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" Height="48"
                   VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 右:选中空间的成员与协作动作 -->
    <Border Grid.Column="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="SelectedSpaceTitle" FontSize="16" FontWeight="SemiBold"
                   Text="{Binding [Spaces.NoSelection], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock x:Name="SelectedSpaceRole" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" />

        <TextBlock Margin="0,14,0,0" FontWeight="SemiBold"
                   Text="{Binding [Spaces.Members], Source={x:Static loc:Loc.Instance}}" />
        <ListBox x:Name="MemberList" Height="140" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBox x:Name="InviteUsername" Width="120" />
          <ComboBox x:Name="InvitePermission" Width="100" Margin="8,0,0,0" SelectedIndex="2">
            <ComboBoxItem Content="manager" />
            <ComboBoxItem Content="editor" />
            <ComboBoxItem Content="reader" />
          </ComboBox>
          <Button x:Name="InviteButton" Margin="8,0,0,0" Padding="14,8"
                  Content="{Binding [Spaces.Invite], Source={x:Static loc:Loc.Instance}}" Click="OnInvite" />
          <Button x:Name="RemoveButton" Margin="8,0,0,0" Padding="14,8"
                  Content="{Binding [Spaces.RemoveMember], Source={x:Static loc:Loc.Instance}}" Click="OnRemoveMember" />
        </StackPanel>

        <Separator Margin="0,14,0,12" />

        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="TransferUsername" Width="120" />
          <Button x:Name="TransferButton" Margin="8,0,0,0" Padding="14,8"
                  Content="{Binding [Spaces.Transfer], Source={x:Static loc:Loc.Instance}}" Click="OnTransfer" />
          <Button x:Name="LeaveButton" Margin="8,0,0,0" Padding="14,8"
                  Content="{Binding [Spaces.Leave], Source={x:Static loc:Loc.Instance}}" Click="OnLeave" />
        </StackPanel>

        <Separator Margin="0,14,0,12" />

        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                   Text="{Binding [Spaces.Dissolve], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"
                   Text="{Binding [Spaces.DissolveHint], Source={x:Static loc:Loc.Instance}}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBox x:Name="DissolveConfirmName" Width="180" />
          <Button x:Name="DissolveButton" Margin="8,0,0,0" Padding="14,8" Style="{StaticResource DangerButton}"
                  Content="{Binding [Spaces.DissolveConfirm], Source={x:Static loc:Loc.Instance}}" Click="OnDissolve" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
