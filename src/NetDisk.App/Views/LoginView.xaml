<UserControl x:Class="NetDisk.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetDisk.App.Views"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 登录 / 首次运行(DE-D-15 的真实落点)。卡片居中,字段上方小标签,密码可切换明文。 -->
  <Grid Background="{StaticResource AppBg}">
    <Border Style="{StaticResource Card}" Width="468" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel>
        <!-- 头部:品牌 + 语言切换(登录前即可切换,免重启;与设置页共用一套 i18n) -->
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentBrush}">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" FontSize="21"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="20" FontWeight="SemiBold"
                         Text="{Binding [Login.Title], Source={x:Static loc:Loc.Instance}}" />
              <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                         Text="{Binding [Login.Subtitle], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
          </StackPanel>
          <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="118" VerticalAlignment="Top"
                    SelectionChanged="OnLanguageChanged" />
        </Grid>

        <!-- 字段 -->
        <StackPanel Margin="0,20,0,0">
          <TextBlock Style="{StaticResource SectionLabel}"
                     Text="{Binding [Login.Server], Source={x:Static loc:Loc.Instance}}" />
          <TextBox x:Name="ServerBox" />

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,0"
                     Text="{Binding [Login.Username], Source={x:Static loc:Loc.Instance}}" />
          <TextBox x:Name="UserBox" />

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,0"
                     Text="{Binding [Login.Password], Source={x:Static loc:Loc.Instance}}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="PassBox" Grid.Column="0" Padding="9,6,38,6" />
            <TextBox x:Name="PassTextBox" Grid.Column="0" Visibility="Collapsed" Padding="9,6,38,6" />
            <Button x:Name="PassToggle" Grid.Column="1" Width="36" Margin="6,0,0,0" Click="OnTogglePassword"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="显示/隐藏密码">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;" FontSize="16"
                         Foreground="{StaticResource TextSecondary}" />
            </Button>
          </Grid>

          <TextBlock Style="{StaticResource SectionLabel}" Margin="0,14,0,0"
                     Text="{Binding [Login.SyncRoot], Source={x:Static loc:Loc.Instance}}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RootBox" Grid.Column="0" Margin="0,0,8,0" />
            <Button x:Name="BrowseButton" Grid.Column="1" Padding="14,7"
                    Content="{Binding [Login.Browse], Source={x:Static loc:Loc.Instance}}" Click="OnBrowse" />
          </Grid>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LoginButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Padding="24,9" FontWeight="SemiBold"
                    Content="{Binding [Login.Start], Source={x:Static loc:Loc.Instance}}" Click="OnLogin" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="520" />
          </Grid>
        </StackPanel>

        <!-- 首次运行提示 -->
        <Border Margin="0,18,0,0" Padding="13,12" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
          <StackPanel>
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding [Login.FirstRun], Source={x:Static loc:Loc.Instance}}" />
            <TextBlock x:Name="OnboardingText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondary}"
                       Text="{Binding [Login.FirstRunHint], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
