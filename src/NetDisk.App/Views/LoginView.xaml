<UserControl x:Class="NetDisk.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetDisk.App.Views"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 登录 / 首次运行(DE-D-15 的真实落点)。
       在此之前客户端只认环境变量 NETDISK_BASE_URL —— 而装完 MSI 的用户打不开环境变量,
       于是界面永远显示"未配置服务端地址"。所以服务器地址必须能在界面上填、并落盘。 -->
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock FontSize="22" FontWeight="SemiBold"
                 Text="{Binding [Login.Title], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"
                 Text="{Binding [Login.Subtitle], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding [Login.Server], Source={x:Static loc:Loc.Instance}}" />
      <TextBox x:Name="ServerBox" Grid.Column="1" Padding="6,4" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding [Login.Username], Source={x:Static loc:Loc.Instance}}" />
      <TextBox x:Name="UserBox" Grid.Column="1" Padding="6,4" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding [Login.Password], Source={x:Static loc:Loc.Instance}}" />
      <PasswordBox x:Name="PassBox" Grid.Column="1" Padding="6,4" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding [Login.SyncRoot], Source={x:Static loc:Loc.Instance}}" />
      <TextBox x:Name="RootBox" Grid.Column="1" Padding="6,4" />
      <Button x:Name="BrowseButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
              Content="{Binding [Login.Browse], Source={x:Static loc:Loc.Instance}}" Click="OnBrowse" />
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0">
      <Button x:Name="LoginButton" Padding="18,6" FontWeight="SemiBold"
              Content="{Binding [Login.Start], Source={x:Static loc:Loc.Instance}}" Click="OnLogin" />
      <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="#B00" TextWrapping="Wrap" MaxWidth="520" />
    </StackPanel>

    <Border Grid.Row="6" Margin="0,16,0,0" Padding="12" Background="#F6F7F9"
            BorderBrush="#E0E2E6" BorderThickness="1">
      <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Text="{Binding [Login.FirstRun], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock x:Name="OnboardingText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#444"
                   Text="{Binding [Login.FirstRunHint], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
