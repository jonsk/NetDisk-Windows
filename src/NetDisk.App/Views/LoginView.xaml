<UserControl x:Class="NetDisk.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetDisk.App.Views">
  <!-- 登录 / 首次运行(DE-D-15 的真实落点)。
       在此之前客户端只认环境变量 NETDISK_BASE_URL —— 而装完 MSI 的用户打不开环境变量,
       于是界面永远显示"未配置服务端地址"。所以服务器地址必须能在界面上填、并落盘。 -->
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="登录 NetDisk" />
      <TextBlock Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap"
                 Text="填写服务器地址与账号口令。登录成功后本机开始与服务器双向同步。" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="服务器地址" />
      <TextBox x:Name="ServerBox" Grid.Column="1" Padding="6,4" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="用户名" />
      <TextBox x:Name="UserBox" Grid.Column="1" Padding="6,4" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="口令" />
      <PasswordBox x:Name="PassBox" Grid.Column="1" Padding="6,4" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="同步目录" />
      <TextBox x:Name="RootBox" Grid.Column="1" Padding="6,4" />
      <Button x:Name="BrowseButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
              Content="浏览…" Click="OnBrowse" />
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0">
      <Button x:Name="LoginButton" Padding="18,6" FontWeight="SemiBold"
              Content="登录并开始同步" Click="OnLogin" />
      <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="#B00" TextWrapping="Wrap" MaxWidth="520" />
    </StackPanel>

    <Border Grid.Row="6" Margin="0,16,0,0" Padding="12" Background="#F6F7F9"
            BorderBrush="#E0E2E6" BorderThickness="1">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="首次运行" />
        <TextBlock x:Name="OnboardingText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#444"
                   Text="登录后会先列出服务器上的文件,确认目录与数据量,再由你决定是否开始同步。" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
