<UserControl x:Class="NetDisk.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 每个文件的同步状态列表(目标 ④)。
       为什么必须有它:没有它时用户能看到的只有托盘气泡,而气泡是**瞬时**的 ——
       "刚才那个冲突到底处理了没""哪个文件还在传"完全无从确认。
       列表是用户唯一能自查的地方,所以它必须显示**每一个**文件的当前状态与原因。 -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" Text="尚未开始同步" />
      <TextBlock x:Name="AccountText" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
      <Button x:Name="SyncNowButton" Padding="14,4" Content="立即同步" Click="OnSyncNow" />
      <Button x:Name="OpenFolderButton" Margin="8,0,0,0" Padding="14,4"
              Content="打开同步目录" Click="OnOpenFolder" />
      <CheckBox x:Name="LogToggle" Margin="16,0,0,0" VerticalAlignment="Center"
                Content="记录日志" Checked="OnLogToggle" Unchecked="OnLogToggle" />
      <Button x:Name="OpenLogButton" Margin="8,0,0,0" Padding="14,4"
              Content="打开日志" Click="OnOpenLog" />
      <TextBlock x:Name="NoticeText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="#555" TextWrapping="Wrap" MaxWidth="560" />
    </StackPanel>

    <ListView x:Name="StatusList" Grid.Row="2" FontSize="13">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="文件" Width="320" DisplayMemberBinding="{Binding File}" />
          <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding StateText}" />
          <GridViewColumn Header="说明" Width="300" DisplayMemberBinding="{Binding Message}" />
          <GridViewColumn Header="版本" Width="60" DisplayMemberBinding="{Binding Version}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#888" TextWrapping="Wrap"
               Text="状态含义:已同步 = 两端一致;上传中/下载中 = 正在传输;冲突 = 两端都改过,本地版本已另存为冲突副本;错误 = 需要处理的失败。" />
    <TextBlock Grid.Row="4" Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap"
               Text="删除是双向同步的:在同步目录里删掉文件,服务器上也会删;另一端删掉的文件,这里也会删。删除在服务端不可恢复,且删掉的文件不会再出现在上面的列表里(可在日志里查记录)。" />
    <TextBlock x:Name="LogPathText" Grid.Row="5" Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap" />
  </Grid>
</UserControl>
