<UserControl x:Class="NetDisk.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 每个文件的同步状态列表(目标 ④):用户唯一能自查的地方,必须显示每一个文件的当前状态。 -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 头部卡片 -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="SemiBold"
                   Text="{Binding [Sync.NotStarted], Source={x:Static loc:Loc.Instance}}" />
        <TextBlock x:Name="AccountText" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 工具栏 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
      <Button x:Name="SyncNowButton" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="OnSyncNow">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Sync.SyncNow], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <!-- Pause 按钮的文字由代码在 暂停/继续 间切换,保持纯文字(不加图标) -->
      <Button x:Name="PauseButton" Margin="8,0,0,0" Padding="14,8" Click="OnTogglePause"
              Content="{Binding [Sync.Pause], Source={x:Static loc:Loc.Instance}}" />
      <Button x:Name="OpenFolderButton" Margin="8,0,0,0" Padding="14,8" Click="OnOpenFolder">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Sync.OpenFolder], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <CheckBox x:Name="LogToggle" Margin="16,0,0,0" VerticalAlignment="Center"
                Content="{Binding [Sync.Log], Source={x:Static loc:Loc.Instance}}"
                Checked="OnLogToggle" Unchecked="OnLogToggle" />
      <Button x:Name="OpenLogButton" Margin="8,0,0,0" Padding="14,8" Click="OnOpenLog">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Sync.OpenLog], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="NoticeText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="520" />
    </StackPanel>

    <!-- 状态列表 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <ListView x:Name="StatusList" FontSize="13" SelectionChanged="OnStatusSelectionChanged"
                Background="{StaticResource Surface}" BorderThickness="0">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{Binding [Sync.ColFile], Source={x:Static loc:Loc.Instance}}" Width="300">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="14"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding File}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{Binding [Sync.ColState], Source={x:Static loc:Loc.Instance}}" Width="96"
                            DisplayMemberBinding="{Binding StateText}" />
            <GridViewColumn Header="{Binding [Sync.ColProgress], Source={x:Static loc:Loc.Instance}}" Width="170">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding Progress, FallbackValue=0}" VerticalAlignment="Center">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Progress}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="8,0,0,0"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{Binding [Sync.ColMessage], Source={x:Static loc:Loc.Instance}}" Width="230"
                            DisplayMemberBinding="{Binding Message}" />
            <GridViewColumn Header="{Binding [Sync.ColVersion], Source={x:Static loc:Loc.Instance}}" Width="60"
                            DisplayMemberBinding="{Binding Version}" />
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <!-- 冲突处理面板 -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="17" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
          <TextBlock Margin="9,0,0,0" FontWeight="SemiBold"
                     Text="{Binding [Sync.ConflictHint], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
        <TextBlock x:Name="ConflictHintText" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="640" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="KeepLocalButton" Style="{StaticResource PrimaryButton}" Padding="14,8" IsEnabled="False"
                  Click="OnResolveKeepLocal">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding [Sync.KeepLocal], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="KeepRemoteButton" Margin="8,0,0,0" Padding="14,8" IsEnabled="False" Click="OnResolveKeepRemote">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding [Sync.KeepRemote], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="KeepBothButton" Margin="8,0,0,0" Padding="14,8" IsEnabled="False" Click="OnResolveKeepBoth">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding [Sync.KeepBoth], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 状态图例 / 删除说明 / 日志路径 -->
    <StackPanel Grid.Row="4" Margin="2,10,0,0">
      <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                 Text="{Binding [Sync.StateLegend], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                 Text="{Binding [Sync.DeleteNote], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock x:Name="LogPathText" Margin="0,3,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
