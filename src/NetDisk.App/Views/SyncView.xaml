<UserControl x:Class="NetDisk.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 每个文件的同步状态列表(目标 ④)。
       为什么必须有它:没有它时用户能看到的只有托盘气泡,而气泡是**瞬时**的 ——
       "刚才那个冲突到底处理了没""哪个文件还在传"完全无从确认。
       列表是用户唯一能自查的地方,所以它必须显示**每一个**文件的当前状态与原因。 -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold"
                 Text="{Binding [Sync.NotStarted], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock x:Name="AccountText" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
      <Button x:Name="SyncNowButton" Padding="14,4"
              Content="{Binding [Sync.SyncNow], Source={x:Static loc:Loc.Instance}}" Click="OnSyncNow" />
      <Button x:Name="PauseButton" Margin="8,0,0,0" Padding="14,4"
              Content="{Binding [Sync.Pause], Source={x:Static loc:Loc.Instance}}" Click="OnTogglePause" />
      <Button x:Name="OpenFolderButton" Margin="8,0,0,0" Padding="14,4"
              Content="{Binding [Sync.OpenFolder], Source={x:Static loc:Loc.Instance}}" Click="OnOpenFolder" />
      <CheckBox x:Name="LogToggle" Margin="16,0,0,0" VerticalAlignment="Center"
                Content="{Binding [Sync.Log], Source={x:Static loc:Loc.Instance}}"
                Checked="OnLogToggle" Unchecked="OnLogToggle" />
      <Button x:Name="OpenLogButton" Margin="8,0,0,0" Padding="14,4"
              Content="{Binding [Sync.OpenLog], Source={x:Static loc:Loc.Instance}}" Click="OnOpenLog" />
      <TextBlock x:Name="NoticeText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="#555" TextWrapping="Wrap" MaxWidth="560" />
    </StackPanel>

    <ListView x:Name="StatusList" Grid.Row="2" FontSize="13"
              SelectionChanged="OnStatusSelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{Binding [Sync.ColFile], Source={x:Static loc:Loc.Instance}}" Width="320" DisplayMemberBinding="{Binding File}" />
          <GridViewColumn Header="{Binding [Sync.ColState], Source={x:Static loc:Loc.Instance}}" Width="90" DisplayMemberBinding="{Binding StateText}" />
          <GridViewColumn Header="{Binding [Sync.ColProgress], Source={x:Static loc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding ProgressText}" />
          <GridViewColumn Header="{Binding [Sync.ColMessage], Source={x:Static loc:Loc.Instance}}" Width="270" DisplayMemberBinding="{Binding Message}" />
          <GridViewColumn Header="{Binding [Sync.ColVersion], Source={x:Static loc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding Version}" />
        </GridView>
      </ListView.View>
    </ListView>

    <!-- 冲突处理(逐文件):先在列表里选中一行「冲突」,再点其中之一。
         为什么按钮默认**禁用**、并且把"当前选中什么"写出来:第一版三个按钮一直是可点的,
         用户点下去才被告诉"请先选中一行「冲突」"—— 顺序靠猜。现在选中状态一眼可见,
         不可点的原因也写在旁边(状态列表每次刷新都会重建,选中的行会**按路径保住**,见代码后置)。 -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock VerticalAlignment="Center" Foreground="#555"
                 Text="{Binding [Sync.ConflictHint], Source={x:Static loc:Loc.Instance}}" />
      <Button x:Name="KeepLocalButton" Margin="8,0,0,0" Padding="12,4" IsEnabled="False"
              Content="{Binding [Sync.KeepLocal], Source={x:Static loc:Loc.Instance}}" Click="OnResolveKeepLocal" />
      <Button x:Name="KeepRemoteButton" Margin="6,0,0,0" Padding="12,4" IsEnabled="False"
              Content="{Binding [Sync.KeepRemote], Source={x:Static loc:Loc.Instance}}" Click="OnResolveKeepRemote" />
      <Button x:Name="KeepBothButton" Margin="6,0,0,0" Padding="12,4" IsEnabled="False"
              Content="{Binding [Sync.KeepBoth], Source={x:Static loc:Loc.Instance}}" Click="OnResolveKeepBoth" />
      <TextBlock x:Name="ConflictHintText" Margin="12,0,0,0" VerticalAlignment="Center"
                 Foreground="#B06000" TextWrapping="Wrap" MaxWidth="520"
                 Text="{Binding [Sync.ConflictPickHint], Source={x:Static loc:Loc.Instance}}" />
    </StackPanel>

    <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#888" TextWrapping="Wrap"
               Text="{Binding [Sync.StateLegend], Source={x:Static loc:Loc.Instance}}" />
    <TextBlock Grid.Row="5" Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap"
               Text="{Binding [Sync.DeleteNote], Source={x:Static loc:Loc.Instance}}" />
    <TextBlock x:Name="LogPathText" Grid.Row="6" Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap" />
  </Grid>
</UserControl>
