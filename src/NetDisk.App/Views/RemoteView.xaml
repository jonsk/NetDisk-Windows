<UserControl x:Class="NetDisk.App.Views.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 远端文件浏览器:看**整个空间**的结构(而不只是同步目录里那一份)。
       为什么需要它:同步目录是"你选择要同步的那部分",而用户经常要回答的问题是
       "服务器上到底有什么/在哪里" —— 没有这个页面时,只能让人去网页端翻,
       而桌面端明明已经登录、已经有令牌。
       **只读**:这个页面不会上传/下载进同步目录/删除任何东西;预览副本落在临时目录。 -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="PathText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
               TextWrapping="Wrap" Text="{Binding [Remote.Root], Source={x:Static loc:Loc.Instance}}" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
      <Button x:Name="UpButton" Padding="14,4"
              Content="{Binding [Remote.Up], Source={x:Static loc:Loc.Instance}}" Click="OnUp" />
      <Button x:Name="RefreshButton" Margin="8,0,0,0" Padding="14,4"
              Content="{Binding [Remote.Refresh], Source={x:Static loc:Loc.Instance}}" Click="OnRefresh" />
      <Button x:Name="OpenButton" Margin="8,0,0,0" Padding="14,4"
              Content="{Binding [Remote.Preview], Source={x:Static loc:Loc.Instance}}" Click="OnOpen" />
      <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="#555" TextWrapping="Wrap" MaxWidth="560" />
    </StackPanel>

    <ListView x:Name="EntryList" Grid.Row="2" FontSize="13" MouseDoubleClick="OnRowDoubleClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{Binding [Remote.ColName], Source={x:Static loc:Loc.Instance}}" Width="380" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Header="{Binding [Remote.ColKind], Source={x:Static loc:Loc.Instance}}" Width="80" DisplayMemberBinding="{Binding KindText}" />
          <GridViewColumn Header="{Binding [Remote.ColSize], Source={x:Static loc:Loc.Instance}}" Width="90" DisplayMemberBinding="{Binding SizeText}" />
          <GridViewColumn Header="{Binding [Remote.ColVersion], Source={x:Static loc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding Version}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#888" TextWrapping="Wrap"
               Text="{Binding [Remote.Footer], Source={x:Static loc:Loc.Instance}}" />
  </Grid>
</UserControl>
