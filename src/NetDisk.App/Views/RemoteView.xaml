<UserControl x:Class="NetDisk.App.Views.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 远端文件浏览器:只读看整个空间的结构(与同步共用同一令牌)。 -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 当前路径 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="17" Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="PathText" Grid.Row="0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   Margin="12,0,0,0" TextWrapping="Wrap" Text="{Binding [Remote.Root], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </Border>

    <!-- 工具栏 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="UpButton" Padding="14,8" Click="OnUp">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74A;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Remote.Up], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="RefreshButton" Margin="8,0,0,0" Padding="14,8" Click="OnRefresh">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Remote.Refresh], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="OpenButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="OnOpen">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding [Remote.Preview], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                 Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="520" />
    </StackPanel>

    <!-- 文件列表 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <ListView x:Name="EntryList" FontSize="13" MouseDoubleClick="OnRowDoubleClick" BorderThickness="0" Background="{StaticResource Surface}">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{Binding [Remote.ColName], Source={x:Static loc:Loc.Instance}}" Width="360" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="{Binding [Remote.ColKind], Source={x:Static loc:Loc.Instance}}" Width="80" DisplayMemberBinding="{Binding KindText}" />
            <GridViewColumn Header="{Binding [Remote.ColSize], Source={x:Static loc:Loc.Instance}}" Width="96" DisplayMemberBinding="{Binding SizeText}" />
            <GridViewColumn Header="{Binding [Remote.ColVersion], Source={x:Static loc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding Version}" />
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <TextBlock Grid.Row="3" Margin="2,10,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
               Text="{Binding [Remote.Footer], Source={x:Static loc:Loc.Instance}}" />
  </Grid>
</UserControl>
