<UserControl x:Class="NetDisk.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 设置(登录后可用):改服务器地址 / 同步目录 / 并发 / 限速 / 日志 —— 以前只能手改 client.json 再重启。
       两个动作的区别要让人一眼看懂:
         · 「保存并重启同步」= 配置写入 <程序目录>\client.json,然后**用新配置重建同步**(换目录、换限速都生效);
         · 「退出登录」= 吊销服务端令牌 + 删除本地密文,回到登录页(换账号用)。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="设置" />
      <TextBlock x:Name="PathText" Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap" />

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="服务器地址" />
        <TextBox x:Name="ServerBox" Grid.Column="1" Padding="6,4" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="同步目录" />
        <TextBox x:Name="RootBox" Grid.Column="1" Padding="6,4" />
        <Button x:Name="BrowseButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                Content="浏览…" Click="OnBrowse" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="并发数(1-16)" />
        <TextBox x:Name="ConcurrencyBox" Grid.Column="1" Padding="6,4" Width="80" HorizontalAlignment="Left" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="上行限速(KB/s)" />
        <TextBox x:Name="UploadBox" Grid.Column="1" Padding="6,4" Width="80" HorizontalAlignment="Left" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="下行限速(KB/s)" />
        <TextBox x:Name="DownloadBox" Grid.Column="1" Padding="6,4" Width="80" HorizontalAlignment="Left" />
      </Grid>
      <TextBlock Margin="130,4,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="限速填 0 表示不限速。改动在「保存并重启同步」后生效。" />

      <CheckBox x:Name="LogCheck" Margin="0,14,0,0" Content="记录日志(默认启用)" />
      <CheckBox x:Name="StructureOnlyCheck" Margin="0,8,0,0"
                Content="只读浏览(仅结构):只同步目录结构,不下载/不上传/不删" />
      <TextBlock Margin="24,2,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="勾选后:远端目录结构会建到本地,文件**不落盘**(列表里显示为「仅结构」),本地文件也不上传,两端都不删除任何东西。" />

      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="SaveButton" Padding="18,6" FontWeight="SemiBold"
                Content="保存并重启同步" Click="OnSave" />
        <Button x:Name="LogoutButton" Margin="10,0,0,0" Padding="18,6"
                Content="退出登录" Click="OnLogout" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#B00" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
