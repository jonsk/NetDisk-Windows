<UserControl x:Class="NetDisk.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 设置(登录后可用):改服务器地址 / 同步目录 / 并发 / 限速 / 日志 —— 以前只能手改 client.json 再重启。
       两个动作的区别要让人一眼看懂:
         · 「保存并重启同步」= 配置写入 <程序目录>\client.json,然后**用新配置重建同步**(换目录、换限速都生效);
         · 「退出登录」= 吊销服务端令牌 + 删除本地密文,回到登录页(换账号用)。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding [Settings.Title], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock x:Name="PathText" Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap" />

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding [Settings.Server], Source={x:Static loc:Loc.Instance}}" />
        <TextBox x:Name="ServerBox" Grid.Column="1" Padding="6,4" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding [Settings.SyncRoot], Source={x:Static loc:Loc.Instance}}" />
        <TextBox x:Name="RootBox" Grid.Column="1" Padding="6,4" />
        <Button x:Name="BrowseButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                Content="{Binding [Settings.Browse], Source={x:Static loc:Loc.Instance}}" Click="OnBrowse" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding [Settings.Concurrency], Source={x:Static loc:Loc.Instance}}" />
        <TextBox x:Name="ConcurrencyBox" Grid.Column="1" Padding="6,4" Width="80" HorizontalAlignment="Left" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding [Settings.Upload], Source={x:Static loc:Loc.Instance}}" />
        <TextBox x:Name="UploadBox" Grid.Column="1" Padding="6,4" Width="80" HorizontalAlignment="Left" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding [Settings.Download], Source={x:Static loc:Loc.Instance}}" />
        <TextBox x:Name="DownloadBox" Grid.Column="1" Padding="6,4" Width="80" HorizontalAlignment="Left" />
      </Grid>
      <TextBlock Margin="130,4,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="{Binding [Settings.LimitNote], Source={x:Static loc:Loc.Instance}}" />

      <CheckBox x:Name="LogCheck" Margin="0,14,0,0" Content="{Binding [Settings.Log], Source={x:Static loc:Loc.Instance}}" />
      <CheckBox x:Name="StructureOnlyCheck" Margin="0,8,0,0"
                Content="{Binding [Settings.StructureOnly], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock Margin="24,2,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="{Binding [Settings.StructureOnlyNote], Source={x:Static loc:Loc.Instance}}" />

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <TextBlock VerticalAlignment="Center" Width="130" Text="{Binding [Settings.OnConflict], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox x:Name="ConflictCombo" Width="260">
          <ComboBoxItem Content="{Binding [Settings.OnConflictKeepBoth], Source={x:Static loc:Loc.Instance}}" />
          <ComboBoxItem Content="{Binding [Settings.OnConflictKeepLocal], Source={x:Static loc:Loc.Instance}}" />
          <ComboBoxItem Content="{Binding [Settings.OnConflictKeepRemote], Source={x:Static loc:Loc.Instance}}" />
        </ComboBox>
      </StackPanel>
      <TextBlock Margin="130,4,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="{Binding [Settings.OnConflictNote], Source={x:Static loc:Loc.Instance}}" />

      <!-- 多空间:一个账号可以同时同步多个空间,每个空间一棵本地树。
           为什么要有这个列表:配置里能写多个空间,但用户看不见也改不了 —— 而那才是"多空间"能不能用起来的关键。 -->
      <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="{Binding [Settings.SpacesTitle], Source={x:Static loc:Loc.Instance}}" />
      <ListBox x:Name="SpaceList" Margin="0,6,0,0" Height="96" FontSize="13" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="AddSpaceButton" Padding="12,4" Content="{Binding [Settings.AddSpace], Source={x:Static loc:Loc.Instance}}" Click="OnAddSpace" />
        <Button x:Name="RemoveSpaceButton" Margin="8,0,0,0" Padding="12,4"
                Content="{Binding [Settings.RemoveBinding], Source={x:Static loc:Loc.Instance}}" Click="OnRemoveSpace" />
        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888"
                   Text="{Binding [Settings.RemoveBindingNote], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
      <TextBlock x:Name="SpaceHintText" Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="{Binding [Settings.SpaceHint], Source={x:Static loc:Loc.Instance}}" />

      <!-- 界面语言(2026-09-18 多语言):切换即时生效 -->
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <TextBlock VerticalAlignment="Center" Width="130" Text="{Binding [Settings.Language], Source={x:Static loc:Loc.Instance}}" />
        <ComboBox x:Name="LanguageCombo" Width="160" SelectionChanged="OnLanguageChanged" />
      </StackPanel>
      <TextBlock Margin="130,4,0,0" Foreground="#888" TextWrapping="Wrap"
                 Text="{Binding [Settings.LanguageNote], Source={x:Static loc:Loc.Instance}}" />

      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="SaveButton" Padding="18,6" FontWeight="SemiBold"
                Content="{Binding [Settings.Save], Source={x:Static loc:Loc.Instance}}" Click="OnSave" />
        <Button x:Name="LogoutButton" Margin="10,0,0,0" Padding="18,6"
                Content="{Binding [Settings.Logout], Source={x:Static loc:Loc.Instance}}" Click="OnLogout" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#B00" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
