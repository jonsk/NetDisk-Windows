<UserControl x:Class="NetDisk.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NetDisk.App.Localization">
  <!-- 设置(登录后可用):改服务器/目录/并发/限速/日志。两个动作区别要一眼看懂:
       保存并重启同步 = 写 client.json 并用新配置重建同步;退出登录 = 吊销令牌回登录页。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel MaxWidth="760">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding [Settings.Title], Source={x:Static loc:Loc.Instance}}" />
      <TextBlock x:Name="PathText" Margin="0,6,0,14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />

      <!-- 服务器与目录 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.Server], Source={x:Static loc:Loc.Instance}}" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                       Text="{Binding [Settings.Server], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Column="1" x:Name="ServerBox" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                       Text="{Binding [Settings.SyncRoot], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Column="1" x:Name="RootBox" Margin="0,0,8,0" />
            <Button Grid.Column="2" x:Name="BrowseButton" Padding="14,8"
                    Content="{Binding [Settings.Browse], Source={x:Static loc:Loc.Instance}}" Click="OnBrowse" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 传输 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.Transfer], Source={x:Static loc:Loc.Instance}}" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                       Text="{Binding [Settings.Concurrency], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Column="1" x:Name="ConcurrencyBox" Width="90" HorizontalAlignment="Left" />
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                       Text="{Binding [Settings.Upload], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Column="1" x:Name="UploadBox" Width="90" HorizontalAlignment="Left" />
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                       Text="{Binding [Settings.Download], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Column="1" x:Name="DownloadBox" Width="90" HorizontalAlignment="Left" />
          </Grid>
          <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                     Text="{Binding [Settings.LimitNote], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </Border>

      <!-- 同步行为 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.Behavior], Source={x:Static loc:Loc.Instance}}" />
          <CheckBox x:Name="LogCheck" Content="{Binding [Settings.Log], Source={x:Static loc:Loc.Instance}}" />
          <CheckBox x:Name="StructureOnlyCheck" Margin="0,8,0,0"
                    Content="{Binding [Settings.StructureOnly], Source={x:Static loc:Loc.Instance}}" />
          <TextBlock Margin="24,4,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                     Text="{Binding [Settings.StructureOnlyNote], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </Border>

      <!-- 冲突策略 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.OnConflict], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox x:Name="ConflictCombo" Width="260" HorizontalAlignment="Left">
            <ComboBoxItem Content="{Binding [Settings.OnConflictKeepBoth], Source={x:Static loc:Loc.Instance}}" />
            <ComboBoxItem Content="{Binding [Settings.OnConflictKeepLocal], Source={x:Static loc:Loc.Instance}}" />
            <ComboBoxItem Content="{Binding [Settings.OnConflictKeepRemote], Source={x:Static loc:Loc.Instance}}" />
          </ComboBox>
          <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                     Text="{Binding [Settings.OnConflictNote], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </Border>

      <!-- 多空间绑定 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.SpacesTitle], Source={x:Static loc:Loc.Instance}}" />
          <ListBox x:Name="SpaceList" Height="96" FontSize="13" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="AddSpaceButton" Style="{StaticResource PrimaryButton}" Padding="14,8"
                    Content="{Binding [Settings.AddSpace], Source={x:Static loc:Loc.Instance}}" Click="OnAddSpace" />
            <Button x:Name="RemoveSpaceButton" Margin="8,0,0,0" Padding="14,8"
                    Content="{Binding [Settings.RemoveBinding], Source={x:Static loc:Loc.Instance}}" Click="OnRemoveSpace" />
          </StackPanel>
          <TextBlock x:Name="SpaceHintText" Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                     Text="{Binding [Settings.SpaceHint], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </Border>

      <!-- 界面 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.Language], Source={x:Static loc:Loc.Instance}}" />
          <ComboBox x:Name="LanguageCombo" Width="160" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged" />
          <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                     Text="{Binding [Settings.LanguageNote], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
      </Border>

      <!-- 账号 -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Settings.Account], Source={x:Static loc:Loc.Instance}}" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Padding="20,9"
                    Content="{Binding [Settings.Save], Source={x:Static loc:Loc.Instance}}" Click="OnSave" />
            <Button x:Name="LogoutButton" Margin="10,0,0,0" Padding="20,9" Style="{StaticResource DangerButton}"
                    Content="{Binding [Settings.Logout], Source={x:Static loc:Loc.Instance}}" Click="OnLogout" />
          </StackPanel>
          <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
