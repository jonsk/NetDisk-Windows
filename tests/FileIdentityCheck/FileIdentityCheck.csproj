<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FileIdentityCheck —— DE-D-11 的行为检查器(零额外 NuGet)。
    既有"真的去问 Win32 要文件身份"的实测(改名前后身份不变、跨卷身份不同),
    也有把"身份失效 → 降级比哈希"这条路径跑出来的可控用例。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetDisk.Checks.FileIdentity</RootNamespace>
    <AssemblyName>FileIdentityCheck</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetDisk.ClientCore\NetDisk.ClientCore.csproj" />
    <ProjectReference Include="..\..\src\NetDisk.Transport\NetDisk.Transport.csproj" />
    <ProjectReference Include="..\..\src\NetDisk.SyncEngine\NetDisk.SyncEngine.csproj" />
  </ItemGroup>

</Project>
