<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StateStoreCheck —— DE-D-07 的行为检查器(零额外 NuGet:SyncEngine 自己带 SQLite)。
    "升级不丢态、不重建;可回滚"这三句话都必须能被真的跑出来,而不是写在注释里。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetDisk.Checks.StateStore</RootNamespace>
    <AssemblyName>StateStoreCheck</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetDisk.ClientCore\NetDisk.ClientCore.csproj" />
    <ProjectReference Include="..\..\src\NetDisk.Transport\NetDisk.Transport.csproj" />
    <ProjectReference Include="..\..\src\NetDisk.SyncEngine\NetDisk.SyncEngine.csproj" />
  </ItemGroup>

</Project>
