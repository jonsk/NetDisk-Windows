<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PathsCheck —— **数据文件位置**的行为检查器(零 NuGet)。
    与其它检查器一样:退出码 0 = 全过,1 = 有断言失败。
    它盯的是产品要求 ① 的三条:程序所在目录优先、目录不可用则回退(并在日志里说明)、
    旧位置(%APPDATA%\NetDisk)一次性迁移。为什么必须检查器覆盖:
    这三个分支都只在特定现场才走到("装到 Program Files"与"从旧版本升上来"),
    靠 MSI 安装演练只能看到"正常那一条",看不到回退与迁移。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetDisk.Checks.Paths</RootNamespace>
    <AssemblyName>PathsCheck</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetDisk.SyncEngine\NetDisk.SyncEngine.csproj" />
  </ItemGroup>

</Project>
