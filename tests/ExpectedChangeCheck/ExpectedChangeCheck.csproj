<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ExpectedChangeCheck —— DE-D-10 的行为检查器(零额外 NuGet)。
    核心断言两件事:①连续 1000 次"自己落盘"不产生任何一次远端误判(无回环);
    ②**匹配不上时必须报给状态机** —— 账本绝不能变成"吞掉用户真实修改"的黑洞。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetDisk.Checks.ExpectedChange</RootNamespace>
    <AssemblyName>ExpectedChangeCheck</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetDisk.ClientCore\NetDisk.ClientCore.csproj" />
    <ProjectReference Include="..\..\src\NetDisk.Transport\NetDisk.Transport.csproj" />
    <ProjectReference Include="..\..\src\NetDisk.SyncEngine\NetDisk.SyncEngine.csproj" />
  </ItemGroup>

</Project>
